      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json"
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/index"
            ]
          }
        ]
      },
      {
        "tab": "Roadmap",
        "groups": [
          {
            "group": "Roadmap",
            "pages": [
              "roadmap/index"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://app.orgo.space",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/orgo-space",
          "icon": "github"
        }
      ]
