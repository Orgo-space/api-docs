  "navbar": {
    "links": [
      {
        "label": "Get Started",
        "href": "https://app.orgo.space/register"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "request": {
      "example": "show"
    },
    "maintainOrder": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/orgospace/",
      "github": "https://github.com/orgs/Orgo-space"
    }
