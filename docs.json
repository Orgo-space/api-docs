            "pages": [
              "platform/users/profile-page",
              "platform/users/statuses",
              "platform/users/system-roles",
              "platform/users/privacy-settings",
              "platform/users/familiy-members",
              "platform/users/professional-network",
              "platform/users/resignation",
              "platform/users/deletion-of-account"
            ]
          },
          {
