          },
          {
            "group": "Features",
            "pages": [
              "platform/files",
              "platform/contacts",
              "platform/custom-fields",
              "platform/issues",
              "platform/notifications",
              "platform/adhesions",
              "platform/organisational-chart",
              "platform/contracts",
