# Browser storage state: live session cookies and JWTs for the demo accounts.
# These are credentials. They must never be committed, from anywhere in this tree.
state-*.json
capture/state-*.json

# Local overrides (ORGO_DOCS_PASSWORD and friends).
.env
.env.local

# Run artifacts.
capture/results.json
*.log
probe-*.png
capture/probe-*.png

# Dependencies. Both forms: a trailing slash matches a real directory only, and this
# pipeline is often wired up by symlinking node_modules at an existing Playwright install.
node_modules
node_modules/
capture/node_modules
capture/node_modules/
